# Copy this file to .env and replace every <...> placeholder. Never commit .env.

# PostgreSQL used by docker-compose.yml. URL-encode reserved URL characters in the password.
MURIARC_POSTGRES_DB=muriarc
MURIARC_POSTGRES_USER=muriarc
MURIARC_POSTGRES_PASSWORD=<generate-a-long-random-password>

# Direct server execution (docker-compose builds the equivalent URL itself).
MURIARC_DATABASE_URL=postgresql://muriarc:<url-encoded-password>@127.0.0.1:5432/muriarc
MURIARC_BIND_ADDR=127.0.0.1:8787
MURIARC_UI_DIR=./ui/dist
# Durable roots for imports/exports/snapshots and attachment content.
MURIARC_DATA_ROOT=./var/data
MURIARC_ATTACHMENT_ROOT=./var/attachments
MURIARC_LAB_ID=<stable-uuid-for-this-server-lab>
# Environment Root is reconciled on every Server start. These values are required.
# Keep the real .env mode 600. The plaintext Root password is never committed,
# but remains visible to host administrators, backups, and Docker inspect.
MURIARC_LAB_NAME=<laboratory-display-name>
MURIARC_ROOT_USER_ID=<stable-uuid-for-environment-root>
MURIARC_ROOT_USER_EMAIL=<environment-root-email>
MURIARC_ROOT_USER_NAME=<environment-root-display-name>
MURIARC_ROOT_PASSWORD=<environment-managed-root-password>
# Secure defaults to true. Set false only for explicit loopback HTTP development.
MURIARC_SESSION_COOKIE_SECURE=true
MURIARC_SESSION_TTL_HOURS=12
RUST_LOG=muriarc_server=info,tower_http=info

# Optional shared AI transport. Leave the key empty to fail closed and disable
# /api/v1/ai/settings, /api/v1/ai/turns and /api/v1/ai/approvals.
# Generate exactly 32 random bytes as Base64: openssl rand -base64 32
# Keep version unchanged unless all existing encrypted user AI keys are rotated.
MURIARC_AI_MASTER_KEY=
MURIARC_AI_MASTER_KEY_VERSION=1
# LabAdmin manages allowed Provider endpoints inside MuriArc.

# Optional controlled-preview bearer tokens. Leave empty after persistent login/external tokens work.
# If used, each must contain at least 32 non-whitespace characters and they must differ.
MURIARC_BOOTSTRAP_TOKEN=
MURIARC_BOOTSTRAP_MCP_TOKEN=

# Exact comma-separated browser origins allowed to call /mcp. Empty means deny browser origins.
# Non-browser MCP clients normally omit Origin and are still required to use an AI-scoped token.
MURIARC_MCP_ALLOWED_ORIGINS=

# Local desktop/Web development
VITE_MURIARC_GATEWAY=local
# VITE_MURIARC_GATEWAY=remote
# VITE_MURIARC_API_BASE=http://127.0.0.1:8787/api/v1
