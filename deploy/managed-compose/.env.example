# Both images are mandatory immutable digests; tags and latest are rejected by muriarcctl doctor.
MURIARC_SERVER_IMAGE=ghcr.io/jarxunlai/muriarc-server@sha256:REPLACE_64_HEX
MURIARC_POSTGRES_IMAGE=ghcr.io/REPLACE_APPROVED_POSTGRES17@sha256:REPLACE_64_HEX
MURIARC_POSTGRES_USER=muriarc
MURIARC_POSTGRES_PASSWORD=REPLACE_LONG_RANDOM_PASSWORD
MURIARC_LAB_ID=REPLACE_STABLE_UUID
MURIARC_LAB_NAME=REPLACE_LAB_NAME
MURIARC_ROOT_USER_ID=REPLACE_DISTINCT_STABLE_UUID
MURIARC_ROOT_USER_EMAIL=REPLACE_ROOT_EMAIL
MURIARC_ROOT_USER_NAME=REPLACE_ROOT_NAME
MURIARC_ROOT_PASSWORD=REPLACE_LONG_RANDOM_PASSWORD
MURIARC_SESSION_COOKIE_SECURE=true
MURIARC_DEPLOYMENT_PROFILE=private
MURIARC_EXTERNAL_API_ENABLED=false
MURIARC_AI_MASTER_KEY_VERSION=1
