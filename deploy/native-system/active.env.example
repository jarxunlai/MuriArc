# Root-owned activation pointer. muriarcctl replaces this file atomically.
# Copy to /var/lib/muriarc/control/active.env with mode 0600.
MURIARC_ACTIVE_GENERATION=REPLACE_ACTIVE_GENERATION_UUID
MURIARC_DATABASE_URL=postgresql://muriarc_app:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/muriarc
MURIARC_DATA_ROOT=/var/lib/muriarc/generations/REPLACE_ACTIVE_GENERATION_UUID/data
MURIARC_ATTACHMENT_ROOT=/var/lib/muriarc/generations/REPLACE_ACTIVE_GENERATION_UUID/attachments
MURIARC_AI_MASTER_KEY_FILE=/var/lib/muriarc/generations/REPLACE_ACTIVE_GENERATION_UUID/secrets/ai-master-key
MURIARC_ACTIVATION_MODE=read-write
