# Copy to /etc/muriarc/server.env with owner root:muriarc and mode 0640.
# Never commit the populated file or include it in an unencrypted backup.
MURIARC_BIND_ADDR=127.0.0.1:8787
MURIARC_UI_DIR=/opt/muriarc/current/ui
MURIARC_PREVIEW_BOOTSTRAP=false
MURIARC_LAB_ID=REPLACE_STABLE_UUID
MURIARC_LAB_NAME=REPLACE_LAB_NAME
MURIARC_ROOT_USER_ID=REPLACE_DISTINCT_STABLE_UUID
MURIARC_ROOT_USER_EMAIL=REPLACE_ROOT_EMAIL
MURIARC_ROOT_USER_NAME=REPLACE_ROOT_NAME
MURIARC_ROOT_PASSWORD=REPLACE_LONG_RANDOM_PASSWORD
MURIARC_SESSION_COOKIE_SECURE=true
MURIARC_SESSION_TTL_HOURS=12
MURIARC_DEPLOYMENT_PROFILE=private
MURIARC_EXTERNAL_API_ENABLED=false
MURIARC_AI_MASTER_KEY_VERSION=1
MURIARC_BOOTSTRAP_TOKEN=
MURIARC_BOOTSTRAP_MCP_TOKEN=
MURIARC_MCP_ALLOWED_ORIGINS=
RUST_LOG=muriarc_server=info,tower_http=info
