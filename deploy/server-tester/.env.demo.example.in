# Copy to .env and replace every REPLACE_ value. Never commit or share .env.
# This mode installs only the immutable synthetic standard-v1 data set.
MURIARC_TESTER_DATASET_MODE=demo
MURIARC_COMPOSE_PROJECT_NAME=muriarc-server-tester-demo
MURIARC_TESTER_SOURCE_COMMIT=@@SOURCE_COMMIT@@
MURIARC_TESTER_SERVER_PORT=8787

MURIARC_POSTGRES_DB=muriarc
MURIARC_POSTGRES_USER=muriarc
MURIARC_POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_HEX_CHARACTERS

MURIARC_DATA_ROOT=/var/lib/muriarc/generation/data
MURIARC_ATTACHMENT_ROOT=/var/lib/muriarc/generation/attachments
MURIARC_AI_MASTER_KEY_FILE=/var/lib/muriarc/generation/secrets/ai-master-key
MURIARC_LAB_ID=4d555249-4152-4300-0000-000000000001
MURIARC_LAB_NAME=MuriArc standard-v1 synthetic lab
MURIARC_ROOT_USER_ID=4d555249-4152-4300-0000-000000000002
MURIARC_ROOT_USER_EMAIL=REPLACE_WITH_ROOT_EMAIL
MURIARC_ROOT_USER_NAME=REPLACE_WITH_ROOT_DISPLAY_NAME
MURIARC_ROOT_PASSWORD=REPLACE_WITH_LONG_UNIQUE_ROOT_PASSWORD

# false is correct only for direct loopback HTTP. Set true behind trusted HTTPS.
MURIARC_SESSION_COOKIE_SECURE=false
MURIARC_SESSION_TTL_HOURS=12
RUST_LOG=muriarc_server=info,tower_http=info
