{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muriarc.test/schemas/standard-v1.json",
  "title": "MuriArc standard-v1 synthetic dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetId",
    "synthetic",
    "projects",
    "cages",
    "animals",
    "genetics",
    "breeding",
    "templates",
    "experiments",
    "cohorts",
    "participations",
    "procedures",
    "events",
    "observationDefinitions",
    "observations",
    "measurements",
    "samples",
    "attachments",
    "expectedCounts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "const": "muriarc-standard-v1" },
    "synthetic": { "const": true },
    "projects": { "type": "array", "minItems": 3, "maxItems": 3 },
    "cages": { "type": "array", "minItems": 10, "maxItems": 10 },
    "animals": { "type": "array", "minItems": 24, "maxItems": 24 },
    "templates": { "type": "array", "minItems": 4, "maxItems": 4 },
    "experiments": { "type": "array", "minItems": 3, "maxItems": 3 },
    "cohorts": { "type": "array", "minItems": 5, "maxItems": 5 },
    "participations": { "type": "array", "minItems": 20, "maxItems": 20 },
    "procedures": { "type": "array", "minItems": 8, "maxItems": 8 },
    "events": { "type": "array", "minItems": 12, "maxItems": 12 },
    "observationDefinitions": { "type": "array", "minItems": 6, "maxItems": 6 },
    "observations": { "type": "array", "minItems": 24, "maxItems": 24 },
    "measurements": { "type": "array", "minItems": 53, "maxItems": 53 },
    "samples": { "type": "array", "minItems": 18, "maxItems": 18 },
    "attachments": { "type": "array", "minItems": 7, "maxItems": 7 },
    "expectedCounts": { "type": "object" }
  },
  "additionalProperties": true
}
