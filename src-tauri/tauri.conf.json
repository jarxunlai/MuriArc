{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuriArc",
  "version": "0.1.0",
  "identifier": "org.muriarc.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MuriArc",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Medical",
    "shortDescription": "Animal research management",
    "longDescription": "MuriArc connects animal lifecycle management with experiment data and controlled AI assistance.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jarxunlai/MuriArc/releases/latest/download/latest.json"
      ],
      "pubkey": "MURIARC_DESKTOP_UPDATER_PUBLIC_KEY_NOT_CONFIGURED",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "MuriArc"
}
