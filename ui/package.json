{
  "name": "muriarc-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "description": "MuriArc responsive desktop and server web client",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@tauri-apps/api": "^2.2.0",
    "@vueuse/core": "^11.3.0",
    "dompurify": "^3.2.6",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.41.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.2.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
